<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_V2" targetNamespace="http://example.com/p2p/v2">
<bpmn:process id="v2_p2p" name="P2P v2 (gates + SLA)" isExecutable="true">
<bpmn:startEvent id="Start" name="Start"/>
<bpmn:userTask id="Task_PR" name="Create PR"/>
<bpmn:userTask id="Task_Approval" name="Approve PR"/>
<bpmn:userTask id="Task_PO" name="Create PO"/>
<bpmn:exclusiveGateway id="GW_POChanged" name="PO_changed?"/>
<bpmn:userTask id="Task_ReApproval" name="Re-approve PO"/>
<bpmn:userTask id="Task_Receipt" name="Receive Goods"/>
<bpmn:exclusiveGateway id="GW_GoodsReceived" name="Goods_received?"/>
<bpmn:exclusiveGateway id="GW_QtyOk" name="Qty_ok?"/>
<bpmn:userTask id="Task_Invoice" name="Verify Invoice"/>
<bpmn:userTask id="Task_Payment" name="Execute Payment"/>
<bpmn:endEvent id="End" name="End"/>
<bpmn:boundaryEvent id="Timer_Approval_SLA" name="Approval SLA 48h" attachedToRef="Task_Approval" cancelActivity="false">
<bpmn:timerEventDefinition><bpmn:timeDuration>PT48H</bpmn:timeDuration></bpmn:timerEventDefinition>
</bpmn:boundaryEvent>
<bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_PR"/>
<bpmn:sequenceFlow id="F2" sourceRef="Task_PR" targetRef="Task_Approval"/>
<bpmn:sequenceFlow id="F3" sourceRef="Task_Approval" targetRef="Task_PO"/>
<bpmn:sequenceFlow id="F4" sourceRef="Task_PO" targetRef="GW_POChanged"/>
<bpmn:sequenceFlow id="F5" name="No" sourceRef="GW_POChanged" targetRef="Task_Receipt"/>
<bpmn:sequenceFlow id="F6" name="Yes" sourceRef="GW_POChanged" targetRef="Task_ReApproval"/>
<bpmn:sequenceFlow id="F7" sourceRef="Task_ReApproval" targetRef="Task_PO"/>
<bpmn:sequenceFlow id="F8" sourceRef="Task_Receipt" targetRef="GW_GoodsReceived"/>
<bpmn:sequenceFlow id="F9" name="Yes" sourceRef="GW_GoodsReceived" targetRef="GW_QtyOk"/>
<bpmn:sequenceFlow id="F10" name="No" sourceRef="GW_GoodsReceived" targetRef="Task_Receipt"/>
<bpmn:sequenceFlow id="F11" name="Yes" sourceRef="GW_QtyOk" targetRef="Task_Invoice"/>
<bpmn:sequenceFlow id="F12" name="No" sourceRef="GW_QtyOk" targetRef="Task_Receipt"/>
<bpmn:sequenceFlow id="F13" sourceRef="Task_Invoice" targetRef="Task_Payment"/>
<bpmn:sequenceFlow id="F14" sourceRef="Task_Payment" targetRef="End"/>
<bpmn:sequenceFlow id="F15" sourceRef="Timer_Approval_SLA" targetRef="Task_ReApproval"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diag_V2">
<bpmndi:BPMNPlane id="Plane_V2" bpmnElement="v2_p2p">
<bpmndi:BPMNShape id="S_Start" bpmnElement="Start"><dc:Bounds x="100" y="100" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_PR" bpmnElement="Task_PR"><dc:Bounds x="160" y="78" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Appr" bpmnElement="Task_Approval"><dc:Bounds x="280" y="78" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_PO" bpmnElement="Task_PO"><dc:Bounds x="400" y="78" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_GW1" bpmnElement="GW_POChanged"><dc:Bounds x="525" y="93" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_ReAppr" bpmnElement="Task_ReApproval"><dc:Bounds x="400" y="200" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Rec" bpmnElement="Task_Receipt"><dc:Bounds x="600" y="78" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_GW2" bpmnElement="GW_GoodsReceived"><dc:Bounds x="725" y="93" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_GW3" bpmnElement="GW_QtyOk"><dc:Bounds x="800" y="93" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Inv" bpmnElement="Task_Invoice"><dc:Bounds x="875" y="78" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Pay" bpmnElement="Task_Payment"><dc:Bounds x="995" y="78" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_End" bpmnElement="End"><dc:Bounds x="1115" y="100" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Timer" bpmnElement="Timer_Approval_SLA"><dc:Bounds x="320" y="150" width="20" height="20"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="E_F1" bpmnElement="F1"><di:waypoint x="136" y="118"/><di:waypoint x="160" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F2" bpmnElement="F2"><di:waypoint x="260" y="118"/><di:waypoint x="280" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F3" bpmnElement="F3"><di:waypoint x="380" y="118"/><di:waypoint x="400" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F4" bpmnElement="F4"><di:waypoint x="500" y="118"/><di:waypoint x="525" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F5" bpmnElement="F5"><di:waypoint x="575" y="118"/><di:waypoint x="600" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F6" bpmnElement="F6"><di:waypoint x="550" y="143"/><di:waypoint x="450" y="200"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F7" bpmnElement="F7"><di:waypoint x="400" y="240"/><di:waypoint x="380" y="158"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F8" bpmnElement="F8"><di:waypoint x="700" y="118"/><di:waypoint x="725" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F9" bpmnElement="F9"><di:waypoint x="775" y="118"/><di:waypoint x="800" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F10" bpmnElement="F10"><di:waypoint x="750" y="143"/><di:waypoint x="650" y="158"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F11" bpmnElement="F11"><di:waypoint x="850" y="118"/><di:waypoint x="875" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F12" bpmnElement="F12"><di:waypoint x="825" y="143"/><di:waypoint x="650" y="158"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F13" bpmnElement="F13"><di:waypoint x="975" y="118"/><di:waypoint x="995" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F14" bpmnElement="F14"><di:waypoint x="1095" y="118"/><di:waypoint x="1115" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F15" bpmnElement="F15"><di:waypoint x="330" y="170"/><di:waypoint x="400" y="240"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane>
</bpmndi:BPMNDiagram>
</bpmn:definitions>
