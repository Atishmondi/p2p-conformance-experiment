<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Normative" targetNamespace="http://example.com/p2p/normative">
<bpmn:process id="normative_p2p" name="P2P Normative (PR-Payment)" isExecutable="true">
<bpmn:startEvent id="Start" name="Start"/>
<bpmn:userTask id="Task_PR" name="Create PR (R1)"/>
<bpmn:userTask id="Task_Approval" name="Approve PR (R2)"/>
<bpmn:userTask id="Task_PO" name="Create PO (R3)"/>
<bpmn:userTask id="Task_Receipt" name="Receive Goods (R4)"/>
<bpmn:userTask id="Task_Invoice" name="Verify Invoice (R5)"/>
<bpmn:userTask id="Task_Payment" name="Execute Payment"/>
<bpmn:endEvent id="End" name="End"/>
<bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_PR"/>
<bpmn:sequenceFlow id="F2" sourceRef="Task_PR" targetRef="Task_Approval"/>
<bpmn:sequenceFlow id="F3" sourceRef="Task_Approval" targetRef="Task_PO"/>
<bpmn:sequenceFlow id="F4" sourceRef="Task_PO" targetRef="Task_Receipt"/>
<bpmn:sequenceFlow id="F5" sourceRef="Task_Receipt" targetRef="Task_Invoice"/>
<bpmn:sequenceFlow id="F6" sourceRef="Task_Invoice" targetRef="Task_Payment"/>
<bpmn:sequenceFlow id="F7" sourceRef="Task_Payment" targetRef="End"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diag_Normative">
<bpmndi:BPMNPlane id="Plane_Normative" bpmnElement="normative_p2p">
<bpmndi:BPMNShape id="S_Start" bpmnElement="Start"><dc:Bounds x="100" y="100" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_PR" bpmnElement="Task_PR"><dc:Bounds x="170" y="78" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Appr" bpmnElement="Task_Approval"><dc:Bounds x="290" y="78" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_PO" bpmnElement="Task_PO"><dc:Bounds x="410" y="78" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Rec" bpmnElement="Task_Receipt"><dc:Bounds x="530" y="78" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Inv" bpmnElement="Task_Invoice"><dc:Bounds x="650" y="78" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Pay" bpmnElement="Task_Payment"><dc:Bounds x="770" y="78" width="100" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_End" bpmnElement="End"><dc:Bounds x="900" y="100" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="E_F1" bpmnElement="F1"><di:waypoint x="136" y="118"/><di:waypoint x="170" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F2" bpmnElement="F2"><di:waypoint x="270" y="118"/><di:waypoint x="290" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F3" bpmnElement="F3"><di:waypoint x="390" y="118"/><di:waypoint x="410" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F4" bpmnElement="F4"><di:waypoint x="510" y="118"/><di:waypoint x="530" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F5" bpmnElement="F5"><di:waypoint x="630" y="118"/><di:waypoint x="650" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F6" bpmnElement="F6"><di:waypoint x="750" y="118"/><di:waypoint x="770" y="118"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F7" bpmnElement="F7"><di:waypoint x="870" y="118"/><di:waypoint x="900" y="118"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane>
</bpmndi:BPMNDiagram>
</bpmn:definitions>
